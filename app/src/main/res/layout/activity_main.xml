<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/matrix_black">

    <com.boyoffi9.matrixrainview.MatrixRainView
        android:id="@+id/matrixRain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:rainColor="@color/matrix_green"
        app:rainSpeed="1.2"
        app:rainDensity="1.0"
        app:rainGlow="true"
        app:rainFadeStrength="28"
        app:rainCharSet="katakana"
        app:rainTouchEffects="avoid|flicker|shockwave"
        app:rainTouchRadius="96dp" />

    <!-- Rain view must be the first/bottom child in the FrameLayout for this to stack correctly -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:id="@+id/bannerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/banner_text"
            android:textColor="@color/matrix_green"
            android:textSize="22sp"
            android:fontFamily="monospace" />

    </LinearLayout>

    <TextView
        android:id="@+id/hintText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="16dp"
        android:alpha="0.6"
        android:fontFamily="monospace"
        android:text="@string/hint_touch"
        android:textColor="@color/matrix_green"
        android:textSize="12sp" />

    <!-- Toggle button for the settings panel -->
    <Button
        android:id="@+id/settingsToggle"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="@string/settings_icon"
        android:textSize="20sp"
        android:background="@drawable/round_button_bg"
        android:textColor="@color/matrix_green" />

    <!-- Launches the Jetpack Compose version of this same demo -->
    <Button
        android:id="@+id/composeDemoButton"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:paddingHorizontal="16dp"
        android:text="@string/compose_demo_button"
        android:textSize="13sp"
        android:background="@drawable/round_button_bg"
        android:textColor="@color/matrix_green" />

    <!-- Settings panel, hidden until toggled -->
    <ScrollView
        android:id="@+id/settingsPanel"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:layout_marginBottom="80dp"
        android:background="@drawable/settings_panel_bg"
        android:visibility="gone"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/SettingsLabel"
                android:text="@string/label_color" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <View android:id="@+id/swatchGreen" style="@style/ColorSwatch" android:background="@drawable/swatch_green" />
                <View android:id="@+id/swatchCyan" style="@style/ColorSwatch" android:background="@drawable/swatch_cyan" />
                <View android:id="@+id/swatchAmber" style="@style/ColorSwatch" android:background="@drawable/swatch_amber" />
                <View android:id="@+id/swatchRed" style="@style/ColorSwatch" android:background="@drawable/swatch_red" />
                <View android:id="@+id/swatchPurple" style="@style/ColorSwatch" android:background="@drawable/swatch_purple" />
                <View android:id="@+id/swatchWhite" style="@style/ColorSwatch" android:background="@drawable/swatch_white" />

            </LinearLayout>

            <TextView
                style="@style/SettingsLabel"
                android:text="@string/label_speed" />
            <SeekBar
                android:id="@+id/speedSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="30"
                android:progress="12" />

            <TextView
                style="@style/SettingsLabel"
                android:text="@string/label_density" />
            <SeekBar
                android:id="@+id/densitySeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="20"
                android:progress="10" />

            <TextView
                style="@style/SettingsLabel"
                android:text="@string/label_fade" />
            <SeekBar
                android:id="@+id/fadeSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="60"
                android:min="8"
                android:progress="28" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    style="@style/SettingsLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginBottom="0dp"
                    android:text="@string/label_glow" />

                <Switch
                    android:id="@+id/glowSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />

            </LinearLayout>

            <TextView
                style="@style/SettingsLabel"
                android:layout_marginTop="12dp"
                android:text="@string/label_charset" />

            <RadioGroup
                android:id="@+id/charsetGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioKatakana"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/matrix_green"
                    android:text="@string/charset_katakana"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/radioBinary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/matrix_green"
                    android:text="@string/charset_binary" />

                <RadioButton
                    android:id="@+id/radioAlnum"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/matrix_green"
                    android:text="@string/charset_alnum" />

            </RadioGroup>

            <TextView
                style="@style/SettingsLabel"
                android:layout_marginTop="16dp"
                android:text="@string/label_touch" />

            <LinearLayout style="@style/SettingsRow">
                <TextView style="@style/SettingsRowLabel" android:text="@string/touch_avoid" />
                <Switch android:id="@+id/avoidSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout style="@style/SettingsRow">
                <TextView style="@style/SettingsRowLabel" android:text="@string/touch_flicker" />
                <Switch android:id="@+id/flickerSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout style="@style/SettingsRow">
                <TextView style="@style/SettingsRowLabel" android:text="@string/touch_shockwave" />
                <Switch android:id="@+id/shockwaveSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout style="@style/SettingsRow">
                <TextView style="@style/SettingsRowLabel" android:text="@string/touch_glitch" />
                <Switch android:id="@+id/touchGlitchSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                style="@style/SettingsLabel"
                android:layout_marginTop="8dp"
                android:text="@string/label_radius" />
            <SeekBar
                android:id="@+id/radiusSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="160"
                android:progress="56" />

            <TextView
                style="@style/SettingsLabel"
                android:layout_marginTop="8dp"
                android:text="@string/label_glitch" />
            <SeekBar
                android:id="@+id/glitchSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="0" />

            <LinearLayout style="@style/SettingsRow">
                <TextView style="@style/SettingsRowLabel" android:text="@string/label_transparent" />
                <Switch android:id="@+id/transparentSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>
