<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/matrix_black">

    <com.boyoffi9.matrixrainview.MatrixRainView
        android:id="@+id/matrixRain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:rainColor="@color/matrix_green"
        app:rainSpeed="1.2"
        app:rainDensity="1.0"
        app:rainGlow="true"
        app:rainFadeStrength="28"
        app:rainCharSet="katakana" />

    <!-- Rain view must be the first/bottom child in the FrameLayout for this to stack correctly -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/banner_text"
            android:textColor="@color/matrix_green"
            android:textSize="22sp"
            android:fontFamily="monospace" />

    </LinearLayout>

</FrameLayout>
