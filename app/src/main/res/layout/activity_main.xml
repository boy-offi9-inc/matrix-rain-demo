<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/matrix_black">

    <com.boyoffi9.matrixrainview.MatrixRainView
        android:id="@+id/matrixRain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:rainColor="@color/matrix_green"
        app:rainSpeed="1.2"
        app:rainDensity="1.0"
        app:rainGlow="true"
        app:rainFadeStrength="28"
        app:rainCharSet="katakana"
        app:rainTouchEffects="avoid|flicker|shockwave"
        app:rainTouchRadius="96dp" />

    <!-- Everything above the rain: a stage on top, the console sheet underneath -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/bannerText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="monospace"
                android:tag="accent"
                android:text="@string/banner_text"
                android:textColor="@color/matrix_green"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/hintText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="16dp"
                android:fontFamily="monospace"
                android:text="@string/hint_touch"
                android:textColor="@color/term_dim"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/composeDemoButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"
                android:background="@drawable/term_button_bg"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="monospace"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:tag="accent_outline"
                android:text="@string/compose_demo_button"
                android:textColor="@color/matrix_green"
                android:textSize="12sp" />

        </FrameLayout>

        <!-- Console sheet; clickable so touches on it never reach the rain -->
        <LinearLayout
            android:id="@+id/sheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/term_sheet_bg"
            android:clickable="true"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/sheetHeader"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    android:id="@+id/promptText"
                    style="@style/TermValue"
                    android:text="@string/prompt"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/cursorText"
                    style="@style/TermValue"
                    android:layout_marginStart="4dp"
                    android:text="@string/cursor"
                    android:textSize="13sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/sheetState"
                    style="@style/TermValue"
                    android:text="@string/sheet_collapse"
                    android:textSize="13sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/sheetBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:id="@+id/tabLook"
                        style="@style/TermSegment"
                        android:text="@string/tab_look" />

                    <TextView
                        android:id="@+id/tabTouch"
                        style="@style/TermSegment"
                        android:text="@string/tab_touch" />

                    <TextView
                        android:id="@+id/tabFx"
                        style="@style/TermSegment"
                        android:text="@string/tab_fx" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/term_line" />

                <!-- Height is set in code so switching tabs never resizes the sheet -->
                <ScrollView
                    android:id="@+id/sheetScroll"
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <!-- LOOK -->
                        <LinearLayout
                            android:id="@+id/paneLook"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingBottom="12dp">

                            <TextView
                                style="@style/TermLabel"
                                android:layout_width="wrap_content"
                                android:layout_marginTop="12dp"
                                android:layout_weight="0"
                                android:text="@string/label_color" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="horizontal">

                                <View android:id="@+id/swatchGreen" style="@style/ColorSwatch" android:background="@drawable/swatch_green" />
                                <View android:id="@+id/swatchCyan" style="@style/ColorSwatch" android:background="@drawable/swatch_cyan" />
                                <View android:id="@+id/swatchAmber" style="@style/ColorSwatch" android:background="@drawable/swatch_amber" />
                                <View android:id="@+id/swatchRed" style="@style/ColorSwatch" android:background="@drawable/swatch_red" />
                                <View android:id="@+id/swatchPurple" style="@style/ColorSwatch" android:background="@drawable/swatch_purple" />
                                <View android:id="@+id/swatchWhite" style="@style/ColorSwatch" android:background="@drawable/swatch_white" />

                            </LinearLayout>

                            <TextView
                                style="@style/TermLabel"
                                android:layout_width="wrap_content"
                                android:layout_marginTop="14dp"
                                android:layout_weight="0"
                                android:text="@string/label_glyphs" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/glyphKatakana"
                                    style="@style/TermSegment"
                                    android:text="@string/glyphs_katakana" />

                                <TextView
                                    android:id="@+id/glyphBinary"
                                    style="@style/TermSegment"
                                    android:text="@string/glyphs_binary" />

                                <TextView
                                    android:id="@+id/glyphAlnum"
                                    style="@style/TermSegment"
                                    android:text="@string/glyphs_alnum" />

                            </LinearLayout>

                            <LinearLayout style="@style/TermLabelRow">
                                <TextView style="@style/TermLabel" android:text="@string/label_speed" />
                                <TextView android:id="@+id/speedValue" style="@style/TermValue" />
                            </LinearLayout>
                            <SeekBar
                                android:id="@+id/speedSeek"
                                style="@style/TermSeek"
                                android:max="30"
                                android:progress="12" />

                            <LinearLayout style="@style/TermLabelRow">
                                <TextView style="@style/TermLabel" android:text="@string/label_density" />
                                <TextView android:id="@+id/densityValue" style="@style/TermValue" />
                            </LinearLayout>
                            <SeekBar
                                android:id="@+id/densitySeek"
                                style="@style/TermSeek"
                                android:max="20"
                                android:progress="10" />

                            <LinearLayout style="@style/TermLabelRow">
                                <TextView style="@style/TermLabel" android:text="@string/label_fade" />
                                <TextView android:id="@+id/fadeValue" style="@style/TermValue" />
                            </LinearLayout>
                            <SeekBar
                                android:id="@+id/fadeSeek"
                                style="@style/TermSeek"
                                android:max="60"
                                android:progress="28" />

                            <CheckBox
                                android:id="@+id/glowSwitch"
                                style="@style/TermCheck"
                                android:layout_marginTop="6dp"
                                android:checked="true"
                                android:text="@string/glow" />

                        </LinearLayout>

                        <!-- TOUCH -->
                        <LinearLayout
                            android:id="@+id/paneTouch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingTop="6dp"
                            android:paddingBottom="12dp"
                            android:visibility="gone">

                            <CheckBox android:id="@+id/avoidSwitch" style="@style/TermCheck" android:text="@string/touch_avoid" />
                            <CheckBox android:id="@+id/flickerSwitch" style="@style/TermCheck" android:text="@string/touch_flicker" />
                            <CheckBox android:id="@+id/shockwaveSwitch" style="@style/TermCheck" android:text="@string/touch_shockwave" />
                            <CheckBox android:id="@+id/touchGlitchSwitch" style="@style/TermCheck" android:text="@string/touch_glitch" />

                            <LinearLayout style="@style/TermLabelRow">
                                <TextView style="@style/TermLabel" android:text="@string/label_radius" />
                                <TextView android:id="@+id/radiusValue" style="@style/TermValue" />
                            </LinearLayout>
                            <SeekBar
                                android:id="@+id/radiusSeek"
                                style="@style/TermSeek"
                                android:max="160"
                                android:progress="56" />

                        </LinearLayout>

                        <!-- FX -->
                        <LinearLayout
                            android:id="@+id/paneFx"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingBottom="12dp"
                            android:visibility="gone">

                            <LinearLayout style="@style/TermLabelRow">
                                <TextView style="@style/TermLabel" android:text="@string/label_glitch" />
                                <TextView android:id="@+id/glitchValue" style="@style/TermValue" />
                            </LinearLayout>
                            <SeekBar
                                android:id="@+id/glitchSeek"
                                style="@style/TermSeek"
                                android:max="100"
                                android:progress="0" />

                            <CheckBox
                                android:id="@+id/transparentSwitch"
                                style="@style/TermCheck"
                                android:layout_marginTop="8dp"
                                android:text="@string/transparent" />

                            <TextView
                                style="@style/TermNote"
                                android:text="@string/transparent_note" />

                        </LinearLayout>

                    </FrameLayout>

                </ScrollView>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
